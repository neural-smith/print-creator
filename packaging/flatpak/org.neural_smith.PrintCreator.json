{
  "app-id": "org.neural_smith.PrintCreator",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "print-creator",
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--filesystem=home",
    "--socket=cups"
  ],
  "modules": [
    {
      "name": "print-creator",
      "buildsystem": "simple",
      "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "env": {
          "CARGO_HOME": "/run/build/print-creator/.cargo-home",
          "CARGO_NET_OFFLINE": "true"
        }
      },
      "build-commands": [
        "cargo build --offline --locked --release --features gui",
        "install -Dm755 target/release/print-creator /app/bin/print-creator",
        "tools/upx --best --lzma /app/bin/print-creator",
        "tools/upx --test /app/bin/print-creator",
        "install -Dm644 packaging/desktop/org.neural_smith.PrintCreator.desktop /app/share/applications/org.neural_smith.PrintCreator.desktop",
        "install -Dm644 packaging/desktop/org.neural_smith.PrintCreator.metainfo.xml /app/share/metainfo/org.neural_smith.PrintCreator.metainfo.xml",
        "install -Dm644 assets/icons/org.neural_smith.PrintCreator.svg /app/share/icons/hicolor/scalable/apps/org.neural_smith.PrintCreator.svg",
        "install -Dm644 assets/icons/org.neural_smith.PrintCreator-256.png /app/share/icons/hicolor/256x256/apps/org.neural_smith.PrintCreator.png",
        "install -Dm644 LICENSE /app/share/licenses/print-creator/LICENSE"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "source"
        }
      ]
    }
  ]
}
